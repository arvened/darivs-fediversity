name": "darivs-fediversity",
  "version": "0.1.0",
  "description": "Self-hosted decentralized charitable prediction platform with service portability and federation",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:migrate": "ts-node scripts/migrate.ts",
    "db:seed": "ts-node scripts/seed.ts"
  },
  "keywords": [
    "charity",
    "prediction",
    "fediversity",
    "self-hosted",
    "decentralized"
  ],
  "author": "Eduard Arbitman, Yaroslav Oseledko",
  "license": "MIT",
  "dependencies": {
    "fastify": "^4.24.0",
    "fastify-cors": "^8.4.2",
    "fastify-helmet": "^11.1.1",
    "fastify-jwt": "^7.2.4",
    "pg": "^8.11.3",
    "redis": "^4.6.11",
    "prisma": "^5.7.0",
    "@prisma/client": "^5.7.0",
    "zod": "^3.22.4",
    "crypto": "^1.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2",
    "prettier": "^3.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
